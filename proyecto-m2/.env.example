PORT=3000

# Conexión local a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitacora
DB_USER=postgres
DB_PASSWORD=tu_password

# En producción (Railway, Render, etc.) basta con DATABASE_URL
# DATABASE_URL=postgresql://usuario:password@host:5432/bitacora
# DB_SSL=false   # solo si tu DATABASE_URL no acepta SSL (ej. red interna de Railway)
